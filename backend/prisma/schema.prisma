generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum TransactionType {
  UPI
  CARD
  NET_BANKING
  ATM
}

enum TransactionStatus {
  SAFE
  FLAGGED
  CONFIRMED_FRAUD
}

enum CaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AuditAction {
  LOGIN
  CREATE_TRANSACTION
  FLAG_TRANSACTION
  CREATE_CASE
  ASSIGN_CASE
  RESOLVE_CASE
  UPDATE_ROLE
}

enum EntityType {
  USER
  TRANSACTION
  CASE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  assignedCases Case[]
  auditLogs AuditLog[]
}

model Transaction {
  id              String            @id @default(uuid())

  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("INR")

  merchant        String

  city            String
  country         String

  ipAddress       String
  deviceId        String

  transactionType TransactionType

  riskScore       Int               @default(0)

  status          TransactionStatus @default(SAFE)

  createdAt       DateTime          @default(now())

  userId          String
  user            User              @relation(fields: [userId], references: [id])

  case            Case?

  @@index([userId])
  @@index([status])
}

model Case {
  id             String      @id @default(uuid())

  title          String
  description    String?

  status         CaseStatus  @default(OPEN)
  priority       Priority    @default(MEDIUM)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactionId  String      @unique
  transaction    Transaction @relation(fields: [transactionId], references: [id])

  assignedToId   String?
  assignedTo     User?       @relation(fields: [assignedToId], references: [id])

  @@index([status])
}

model AuditLog {
  id          String       @id @default(uuid())

  action      AuditAction

  entityType  EntityType
  entityId    String

  description String

  createdAt   DateTime     @default(now())

  userId      String
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
}